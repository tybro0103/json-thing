{
  "name": "JSON Thing",
  "description": "Why so ugly?",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "menu.html",
    "default_icon": "icon/icon-128.png"
  },
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  },
  "content_scripts": [
    {
      "js": ["main.js"],
      "css": ["main.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["storage"]
}
